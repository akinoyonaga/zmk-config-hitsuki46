#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>
#include <input/processors/sensor_rotation.dtsi>
#include <layout_shift_kp_override.dtsi>

&mt {
    flavor = "balanced";
    quick-tap-ms = <0>;
};

// &trackball {
//     // Note: automouse-layer and scroll-layers are no longer supported in badjeff/zmk-pmw3610-driver
//     // These features should now be configured using layer-based zmk,input-listener in keymap
//     // automouse-layer = <1>;
//     // scroll-layers = <5>;
// };

/ {
    macros {
        emoji: emoji_macro {
            compatible = "zmk,behavior-macro";
            label = "EMOJI";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp CAPSLOCK>,
                <&macro_tap>,
                <&kp E>,
                <&macro_release>,
                <&kp CAPSLOCK>;
        };

        to_layer_0: to_layer_0 {
            compatible = "zmk,behavior-macro-one-param";
            #binding-cells = <1>;
            bindings = <&to 0 &macro_param_1to1 &kp MACRO_PLACEHOLDER>;
            label = "TO_LAYER_0";
        };

        bt0_win: bt0_win {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&tog_off 1>,
                <&macro_wait_time 100>,
                <&bt BT_SEL 0>,
                <&macro_wait_time 500>;

            label = "BT0_WN";
        };

        bt1_win: bt1_win {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&tog_off 1>,
                <&macro_wait_time 200>,
                <&bt BT_SEL 1>,
                <&macro_wait_time 500>;

            label = "BT1_WIN";
        };

        bt2_mac: bt2_mac {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&tog_off 1>,
                <&macro_wait_time 200>,
                <&bt BT_SEL 2>,
                <&macro_wait_time 500>,
                <&tog_on 1>;

            label = "BT1";
        };

        bt3_mac: bt3_mac {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&tog_off 1>,
                <&macro_wait_time 200>,
                <&bt BT_SEL 3>,
                <&macro_wait_time 500>,
                <&tog_on 1>;

            label = "BT3_WIN";
        };

        bt4_win: bt4_win {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&tog_off 1>,
                <&macro_wait_time 200>,
                <&bt BT_SEL 4>,
                <&macro_wait_time 500>;

            label = "BT4_WIN";
        };
    };

    behaviors {
        repeat_lt: repeat_layer_tap {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            bindings = <&mo>, <&kp>;
            flavor = "tap-preferred";
            tapping-term-ms = <200>;
            quick-tap-ms = <200>;
            display-name = "Repeat Layer-Tap";
        };

        encoder_msc: sensor_rotate_msc {
            compatible = "zmk,behavior-sensor-rotate-var";
            #sensor-binding-cells = <2>;
            bindings = <&msc>, <&msc>;

            tap-ms = <20>;
        };

        encoder_kp: sensor_rotate_kp {
            compatible = "zmk,behavior-sensor-rotate-var";
            #sensor-binding-cells = <2>;
            bindings = <&kp>, <&kp>;
        };

        lt_to_layer_0: lt_to_layer_0 {
            compatible = "zmk,behavior-hold-tap";
            label = "LAYER_TAP_TO_0";
            bindings = <&mo>, <&to_layer_0>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
        };

        // 新しいスクロール動作

        scroll_up_down: behavior_sensor_rotate_mouse_wheel_up_down {
            compatible = "zmk,behavior-sensor-rotate";
            #sensor-binding-cells = <0>;
            bindings = <&msc SCRL_UP>, <&msc SCRL_DOWN>;

            // 追加: スクロールのタップ時間を設定 (20ms)

            tap-ms = <20>;
        };

        tog_on: toggle_layer_on {
            compatible = "zmk,behavior-toggle-layer";
            #binding-cells = <1>;
            display-name = "Toggle Layer On";
            toggle-mode = "on";
        };

        tog_off: toggle_layer_off {
            compatible = "zmk,behavior-toggle-layer";
            #binding-cells = <1>;
            display-name = "Toggle Layer Off";
            toggle-mode = "off";
        };
    };

    combos {
        compatible = "zmk,combos";

        atmark {
            bindings = <&kp AT>;
            key-positions = <9 10>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            display-name = "Default Layer";
            bindings = <
&kp TAB                &kp Q           &kp W   &kp E               &kp R        &kp T  &kp Y  &kp U            &kp I                    &kp O               &kp P                &kp BACKSPACE
&kp SPACE              &mt LEFT_ALT A  &kp S   &mt LEFT_SHIFT D    &kp F        &kp G  &kp H  &kp J            &mt RIGHT_SHIFT K        &kp L               &mt RIGHT_ALT MINUS  &repeat_lt 2 ENTER
&mt LEFT_SHIFT ESCAPE  &kp Z           &kp X   &mt LEFT_CONTROL C  &kp V        &kp B  &kp N  &kp M            &mt RIGHT_CONTROL COMMA  &kp DOT             &kp SLASH            &kp LEFT_SHIFT
                       &kp LEFT_WIN    &kp AT  &lt 3 TAB           &lt 2 SPACE  &none  &none  &repeat_lt 3 BACKSPACE  &repeat_lt 2 ENTER       &lt 7 SINGLE_QUOTE  &lt 6 LC(SPACE)
            >;
        };

        mac_layer {
            bindings = <
&kp TAB         &kp Q               &kp W   &kp E               &kp R      &kp T        &kp Y          &kp U        &kp I                    &mt LEFT_ALT O      &kp P                &kp BACKSPACE
&kp SPACE       &mt LEFT_COMMAND A  &kp S   &mt LEFT_SHIFT D    &kp F      &kp G        &kp H          &kp J        &mt RIGHT_SHIFT K        &kp L               &mt RIGHT_ALT MINUS  &repeat_lt 2 ENTER
&kp LEFT_SHIFT  &kp Z               &kp X   &mt LEFT_COMMAND C  &kp V      &kp B        &kp N          &kp M        &mt RIGHT_COMMAND COMMA  &kp DOT             &kp SLASH            &kp LEFT_SHIFT
                &kp LEFT_WIN        &kp AT  &none               &lt 3 TAB  &lt 4 SPACE  &kp BACKSPACE  &repeat_lt 4 ENTER  &none               &lt 7 SINGLE_QUOTE  &lt 6 LC(SPACE)
            >;
        };

        layer_2 {
            bindings = <
&none  &kp EXCL              &kp DQT                &kp GRAVE                    &kp F2             &kp F5          &kp LC(PAGE_UP)  &mkp MB4    &mkp MB3           &mkp MB5   &kp LC(PAGE_DOWN)  &none
&none  &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS  &mt LEFT_SHIFT LEFT_BRACKET  &kp RIGHT_BRACKET  &kp TILDE       &kp PAGE_UP      &mkp LCLK   &kp UP_ARROW       &mkp RCLK  &kp HOME           &none
&none  &kp INT_YEN           &kp PIPE               &mt LEFT_CONTROL SEMICOLON   &kp COLON          &kp UNDERSCORE  &kp PAGE_DOWN    &kp LEFT    &kp DOWN_ARROW     &kp RIGHT  &kp END            &none
       &kp LEFT_SHIFT        &kp LEFT_CONTROL       &none                        &to 0              &mo 1           &none            &kp DELETE  &kp K_APPLICATION  &none      &mo 6
            >;
        };

        layer_3 {
            bindings = <
&none  &kp ESCAPE  &kp HASH        &kp DOLLAR            &kp PERCENT    &kp AMPERSAND     &kp SLASH     &kp N7         &kp N8        &kp N9        &kp MINUS   &none
&none  &kp F7      &kp F8          &kp F9                &kp F10        &kp SINGLE_QUOTE  &kp ASTERISK  &kp NUMBER_4   &kp N5        &kp NUMBER_6  &kp PLUS    &none
&none  &kp LA(F4)  &none           &kp LC(SEMICOLON)     &kp LC(COLON)  &kp UNDERSCORE    &kp F4        &kp NUMBER_1   &kp NUMBER_2  &kp NUMBER_3  &kp EQUAL   &none
       &kp LC(F4)  &kp LEFT_SHIFT  &kp LS(LEFT_CONTROL)  &to 0          &tog 3            &none         &kp BACKSPACE  &kp NUMBER_0  &none         &kp DELETE
            >;
        };

        layer_4 {
            bindings = <
&none  &kp EXCL              &kp DQT                           &kp GRAVE                   &kp F2             &kp F5          &kp LC(PAGE_UP)  &kp LG(LEFT_ARROW)  &mkp MB3        &kp LG(C_AL_FILE_BROWSER)  &kp LC(PAGE_DOWN)  &none
&none  &kp LEFT_PARENTHESIS  &mt LEFT_SHIFT RIGHT_PARENTHESIS  &kp LEFT_BRACKET            &kp RIGHT_BRACKET  &kp TILDE       &kp PAGE_UP      &mkp LCLK           &kp UP_ARROW    &mkp RCLK                  &kp HOME           &none
&none  &kp INT_YEN           &kp PIPE                          &mt LEFT_CONTROL SEMICOLON  &kp COLON          &kp UNDERSCORE  &kp PAGE_DOWN    &kp LEFT            &kp DOWN_ARROW  &kp RIGHT                  &kp END            &none
       &kp LEFT_SHIFT        &kp LEFT_CONTROL                  &none                       &to 0              &mo 1           &kp DELETE       &kp K_APP           &none           &none                      &mo 6
            >;
        };

        MOUSE {
            bindings = <
&none  &none  &none  &none   &none  &none  &none  &none      &none  &none      &none  &none
&none  &none  &none  &none   &none  &none  &none  &mkp LCLK  &none  &mkp RCLK  &none  &none
&none  &none  &none  &none   &none  &none  &none  &none      &none  &none      &none  &none
       &none  &none  &tog 0  &none  &none  &none  &none      &none  &none      &none
            >;
        };

        SCROLL {
            bindings = <
&none   &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans      &trans  &none
&none   &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans      &trans  &none
&tog 0  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans      &trans  &tog_ls_on
        &trans  &trans  &none   &tog 0  &trans  &trans  &trans  &none   &tog_ls_on  &none
            >;
        };

        BT {
            bindings = <
&none  &bt0_win    &bt1_win        &bt2_mac  &bt3_mac  &bt4_win  &bt0_win  &bt1_win  &bt2_mac  &bt3_mac  &bt4_win  &none
&none  &none       &none           &none     &none     &none     &none     &none     &none     &none     &none     &none
&none  &bt BT_CLR  &none           &none     &none     &none     &none     &none     &none     &none     &none     &none
       &bt BT_CLR  &bt BT_CLR_ALL  &none     &none     &tog 0    &none     &none     &none     &none     &none
            >;
        };
    };
};
